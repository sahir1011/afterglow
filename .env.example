# Copy this file to ".env" and fill in the values after the = signs.

# YouTube search + trending (free key)
# https://console.cloud.google.com → enable "YouTube Data API v3" → Credentials → Create API key
YOUTUBE_API_KEY=paste-your-key-here

# Spotify (needs Spotify Premium to play songs). Only the Client ID — no secret.
# https://developer.spotify.com/dashboard → Create app → Redirect URI: http://127.0.0.1:5173/callback
SPOTIFY_CLIENT_ID=

PORT=5173
